# Terraform working files — never commit these.

# Downloaded provider plugins + module cache. Hundreds of MB, machine-specific,
# and fully regenerated by `terraform init`. Committing it bloats the repo and
# leaks nothing useful.
.terraform/

# Local state and plan files. State can contain real resource ids and secrets,
# and plan files are point-in-time — neither belongs in git for this setup.
*.tfstate
*.tfstate.*
*.tfplan
tfplan
tfdestroy
crash.log

# Variable files that may hold account-specific or sensitive values
# (e.g. the ECR URL with the account id). Keep these local.
*.auto.tfvars
terraform.tfvars

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — it pins provider
# versions for reproducible builds and SHOULD be committed.
