# Example Terraform variables for ECS Task Definition
# Copy this to terraform.tfvars and customize

aws_region         = "us-east-1"
environment        = "prod"
cluster_name       = "rsps-cluster"
task_family        = "rsps-server"
ecr_repository_url = "<YOUR_ECR_URL>"  # Get from LOT-18: terraform output -raw repository_url

# Container resource allocation
cpu    = 1024  # 1 vCPU (256, 512, 1024, 2048, 4096)
memory = 2048  # 2 GB RAM (512, 1024, 2048, 3072, 4096, etc.)

# Game server ports
container_port_game = 43594
container_port_js5  = 43595

# Logging
log_retention_days = 7
