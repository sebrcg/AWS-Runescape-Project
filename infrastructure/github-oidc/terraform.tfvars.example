# Copy to terraform.tfvars and fill in your values.

aws_region        = "us-east-1"
environment       = "prod"
github_repository = "<owner>/<repo>"      # e.g. sebrcg/AWS-Runescape-Project

# OIDC sub-claim filter (appended after "repo:<owner>/<repo>:")
#   "*"                  -> any ref in the repo (PRs, branches, tags)
#   "pull_request"       -> only PR runs
#   "ref:refs/heads/main"-> only the main branch
subject_claim = "*"

role_name           = "rsps-server-github-actions"
pulumi_state_bucket = "rsps-pulumi-state-<ACCOUNT_ID>"
