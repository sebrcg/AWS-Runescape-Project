# RDS stack: a managed MySQL database for the server, provisioned as code.
# Private (no public access), reachable only from the ECS tasks, with the master
# password generated by RDS and stored in Secrets Manager. Decoupled by name
# from the cluster/network stack, like the other stacks.

terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "rsps-server"
      ManagedBy   = "terraform"
      Environment = var.environment
      Component   = "database"
    }
  }
}

# --- Look up the network (created by the ecs-cluster stack) by tag ---

data "aws_vpc" "main" {
  filter {
    name   = "tag:Name"
    values = ["${var.cluster_name}-vpc"]
  }
}

# The private subnets — the database lives here, so it's unreachable from the
# internet. RDS needs at least two subnets in different AZs for its subnet group.
data "aws_subnets" "private" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.main.id]
  }

  filter {
    name   = "tag:Name"
    values = ["${var.cluster_name}-private-*"]
  }
}

# The ECS tasks' security group — the ONLY thing allowed to reach the database.
data "aws_security_group" "ecs_tasks" {
  vpc_id = data.aws_vpc.main.id

  filter {
    name   = "tag:Name"
    values = ["${var.cluster_name}-ecs-tasks-sg"]
  }
}
