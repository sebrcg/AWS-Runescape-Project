# Inputs for the RDS stack.

variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "us-east-1"
}

variable "environment" {
  description = "Environment name for tagging"
  type        = string
  default     = "prod"
}

variable "cluster_name" {
  description = "ECS cluster name — used to find the VPC, private subnets, and the ECS tasks security group by tag"
  type        = string
  default     = "rsps-cluster"
}

variable "db_name" {
  description = "Initial database name created inside the instance"
  type        = string
  default     = "rsps"
}

variable "db_username" {
  description = "Master username. The password is generated by RDS and stored in Secrets Manager (never set here)."
  type        = string
  default     = "rspsadmin"
}

variable "db_instance_class" {
  description = "RDS instance size (db.t4g.micro is the cheapest / free-tier eligible)"
  type        = string
  default     = "db.t4g.micro"
}

variable "db_allocated_storage" {
  description = "Storage in GB (20 is the minimum)"
  type        = number
  default     = 20
}

variable "db_engine_version" {
  description = "MySQL engine version"
  type        = string
  default     = "8.0"
}
